generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  username                 String                    @unique
  passwordHash             String?
  googleId                 String?                   @unique
  isProfileComplete        Boolean                   @default(false)
  role                     UserRole                  @default(USER)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  avatarConfig             Json?
  expopushtoken            String?
  comments                 Comment[]
  commentVotes             CommentVote[]
  community                Community[]
  communitymember          CommunityMember[]
  acceptedConversations    Conversation[]            @relation("ConversationAccepter")
  blockedConversations     Conversation[]            @relation("ConversationBlocker")
  initiatedConversations   Conversation[]            @relation("ConversationInitiator")
  receivedConversations    Conversation[]            @relation("ConversationRecipient")
  conversationParticipants ConversationParticipant[]
  feedbacks                Feedback[]
  groupsOwned              Group[]
  groupMessages            GroupMessage[]
  groupParticipants        GroupParticipant[]
  helpRequests             HelpRequest[]
  messages                 Message[]
  notificationsReceived    Notification[]            @relation("NotificationsReceived")
  notificationsSent        Notification[]            @relation("NotificationsSent")
  replies                  Reply[]
  replyVotes               ReplyVote[]
  reports                  Report[]
  savedComments            SavedComment[]
  savedThreads             SavedThread[]
  threads                  Thread[]
  votes                    ThreadVote[]
  following                UserFollow[]              @relation("Followers")
  followers                UserFollow[]              @relation("Followings")
  viewedGroupMessages      GroupMessage[]            @relation("ViewOnceGroupViews")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followings", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Community {
  id             String              @id @default(uuid())
  name           String              @unique
  description    String
  imageUrl       String
  topic          CommunityTopic
  visibility     CommunityVisibility @default(PUBLIC)
  allowAnonymous Boolean             @default(false)
  joinCode       String?             @unique
  ownerId        String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  owner          User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        CommunityMember[]
  rules          CommunityRule[]
  reports        Report[]
  threads        Thread[]
}

model CommunityMember {
  id          String        @id @default(uuid())
  userId      String
  communityId String
  username    String
  role        CommunityRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  isMuted     Boolean       @default(false)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
  @@index([communityId])
}

model CommunityRule {
  id          String    @id @default(uuid())
  communityId String
  title       String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  keywords    String[]
  appliesTo   String    @default("POST")
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reports     Report[]

  @@index([communityId])
}

model Thread {
  id            String         @id @default(uuid())
  title         String
  content       String
  upvotes       Int            @default(0)
  downvotes     Int            @default(0)
  username      String
  imageUrl      String?
  communityName String
  communityId   String
  authorId      String
  isAnonymous   Boolean        @default(false)
  isFlagged     Boolean        @default(false)
  isNSFW        Boolean        @default(false)
  hotScore      Float          @default(0)
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  comments      Comment[]
  notifications Notification[]
  reports       Report[]
  savedBy       SavedThread[]
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community     Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  votes         ThreadVote[]

  @@index([communityId])
  @@index([authorId])
  @@index([createdAt])
  @@index([hotScore])
  @@index([commentsCount])
}

model ThreadVote {
  id        String   @id @default(uuid())
  threadId  String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([threadId])
  @@index([userId])
}

model Comment {
  id            String         @id @default(uuid())
  content       String
  username      String
  imageUrl      String?
  upvotes       Int            @default(0)
  downvotes     Int            @default(0)
  netVotes      Int            @default(0)
  threadId      String
  authorId      String
  isAnonymous   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  thread        Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  votes         CommentVote[]
  notifications Notification[]
  replies       Reply[]
  reports       Report[]
  savedBy       SavedComment[]

  @@index([threadId])
  @@index([netVotes])
}

model Reply {
  id            String         @id @default(uuid())
  content       String
  username      String?
  imageUrl      String?
  upvotes       Int            @default(0)
  downvotes     Int            @default(0)
  netVotes      Int            @default(0)
  commentId     String
  authorId      String
  isAnonymous   Boolean        @default(false)
  parentId      String?
  path          String
  depth         Int            @default(0)
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comment       Comment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  parent        Reply?         @relation("ReplyNesting", fields: [parentId], references: [id], onDelete: NoAction)
  children      Reply[]        @relation("ReplyNesting")
  votes         ReplyVote[]
  reports       Report[]
  savedBy       SavedComment[]

  @@index([commentId, path])
  @@index([parentId])
}

model Conversation {
  id           String                    @id @default(uuid())
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @default(now()) @updatedAt
  status       ConversationStatus        @default(PENDING)
  initiatorId  String?
  recipientId  String?
  acceptedAt   DateTime?
  acceptedBy   String?
  blockedAt    DateTime?
  blockedBy    String?
  withdrawnAt  DateTime?
  accepter     User?                     @relation("ConversationAccepter", fields: [acceptedBy], references: [id])
  blocker      User?                     @relation("ConversationBlocker", fields: [blockedBy], references: [id])
  initiator    User?                     @relation("ConversationInitiator", fields: [initiatorId], references: [id])
  recipient    User?                     @relation("ConversationRecipient", fields: [recipientId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([initiatorId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  isMuted        Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String        @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType   @default(TEXT)
  mediaUrl       String?
  isViewOnce     Boolean       @default(false)
  isViewed       Boolean       @default(false)
  status         MessageStatus @default(SENT)
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Group {
  id          String             @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  inviteCode  String             @unique @default(uuid())
  ownerId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  messages    GroupMessage[]
  members     GroupParticipant[]
}

model GroupParticipant {
  id                String    @id @default(uuid())
  groupId           String
  userId            String
  role              GroupRole @default(MEMBER)
  joinedAt          DateTime  @default(now())
  lastReadMessageId String?
  lastReadAt        DateTime?
  isMuted           Boolean   @default(false)
  group             Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupMessage {
  id        String      @id @default(uuid())
  groupId   String
  senderId  String
  content   String
  type      MessageType @default(TEXT)
  mediaUrl  String?
  isViewOnce Boolean     @default(false)
  isDeleted Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  viewedBy  User[]      @relation("ViewOnceGroupViews")

  @@index([groupId])
  @@index([senderId])
  @@index([createdAt])
}

model Report {
  id          String         @id @default(uuid())
  reporterId  String
  communityId String
  threadId    String?
  commentId   String?
  replyId     String?
  ruleId      String?
  reason      String
  description String?
  status      ReportStatus   @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  comment     Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reply       Reply?         @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reporter    User           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  rule        CommunityRule? @relation(fields: [ruleId], references: [id])
  thread      Thread?        @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([reporterId, threadId])
  @@unique([reporterId, commentId])
  @@unique([reporterId, replyId])
  @@index([reporterId])
  @@index([threadId])
  @@index([commentId])
  @@index([replyId])
  @@index([communityId])
}

model SavedThread {
  id        String   @id @default(uuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId])
  @@index([threadId])
}

model SavedComment {
  id        String   @id @default(uuid())
  userId    String
  commentId String?
  replyId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reply     Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@unique([userId, replyId])
  @@index([userId])
  @@index([commentId])
  @@index([replyId])
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model ReplyVote {
  id        String   @id @default(uuid())
  replyId   String
  userId    String
  type      VoteType
  createdAt DateTime @default(now())
  reply     Reply    @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([replyId])
  @@index([userId])
}

model Notification {
  id          String             @id @default(uuid())
  content     String
  type        NotificationType
  status      NotificationStatus @default(UNREAD)
  recipientId String
  senderId    String?
  threadId    String?
  commentId   String?
  replyId     String?
  createdAt   DateTime           @default(now())
  comment     Comment?           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  recipient   User               @relation("NotificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  reply       Reply?             @relation(fields: [replyId], references: [id], onDelete: Cascade)
  sender      User?              @relation("NotificationsSent", fields: [senderId], references: [id], onDelete: Cascade)
  thread      Thread?            @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  username  String?
  content   String
  category  String?
  rating    Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HelpRequest {
  id        String   @id @default(uuid())
  email     String
  content   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum CommunityRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum VoteType {
  UP
  DOWN
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityTopic {
  ANIME_AND_COSPLAY
  ART
  BUSINESS_AND_FINANCE
  COLLECTIBLES_AND_OTHER_HOBBIES
  EDUCATION_AND_CAREER
  FASHION_AND_BEAUTY
  FOOD_AND_DRINKS
  GAMES
  HEALTH
  HOME_AND_GARDEN
  HUMANITIES_AND_LAW
  IDENTITY_AND_RELATIONSHIPS
  INTERNET_CULTURE
  MOVIES_AND_TV
  MUSIC
  NATURE_AND_OUTDOORS
  NEWS_AND_POLITICS
  PLACES_AND_TRAVEL
  POP_CULTURE
  QAS_AND_STORIES
  READING_AND_WRITING
  SCIENCES
  SPOOKY
  SPORTS
  TECHNOLOGY
  VEHICLES
  WELLNESS
  ADULT_CONTENT
  MATURE_TOPICS
}

enum NotificationType {
  REPLY_TO_THREAD
  REPLY_TO_COMMENT
  UPVOTED_THREAD
  UPVOTED_COMMENT
  UPVOTED_REPLY
  NEW_FOLLOWER
  NEW_THREAD
  NEW_MESSAGE
  CHAT_ACCEPTED
}

enum NotificationStatus {
  READ
  UNREAD
}

enum ConversationStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
  WITHDRAWN
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}
